meta {
  name: Add Cart Item
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/store/cart/items
  body: json
  auth: none
}

headers {
  X-Session-ID: test-session-123
}

body:json {
  {
    "product_id": "00000000-0000-0000-0000-000000000000",
    "quantity": 1
  }
}

assert {
  res.status: in [200, 404]
}

docs {
  Adiciona um produto ao carrinho ou incrementa a quantidade se já estiver no carrinho.
}
