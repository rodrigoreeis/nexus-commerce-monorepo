meta {
  name: Health Check
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/health
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.status: eq ok
  res.body.database: eq connected
}

docs {
  Verifica a disponibilidade da API REST do Nexus Commerce e a conectividade ativa com o banco de dados PostgreSQL.
}
