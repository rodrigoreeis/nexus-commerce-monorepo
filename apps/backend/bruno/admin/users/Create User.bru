meta {
  name: Create User
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/admin/users
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{adminToken}}
}

body:json {
  {
    "name": "Maria Gerente",
    "email": "maria.gerente@nexuscommerce.com",
    "password": "password123",
    "role": "manager"
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
  res.body.data.id: isDefined
  res.body.data.email: eq maria.gerente@nexuscommerce.com
  res.body.data.role: eq manager
}

script:post-response {
  if (res.status === 201 && res.body && res.body.data && res.body.data.id) {
    bru.setVar("createdUserId", res.body.data.id);
  }
}

docs {
  Cria um novo usuário do Backoffice.
  - Role 'admin' pode criar 'admin', 'manager' e 'user'.
  - Role 'manager' só pode criar 'user'.
  - Role 'user' não tem permissão para criar usuários.
}
