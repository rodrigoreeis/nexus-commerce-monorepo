meta {
  name: Reset User Password
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/api/admin/users/{{createdUserId}}/password
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{adminToken}}
}

body:json {
  {
    "new_password": "NewSecretPassword123!"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
}

docs {
  Redefine a senha de um usuário do Backoffice respeitando as regras de RBAC:
  - Gerente só pode alterar senha de operador (user)
  - Admin pode alterar senha de admin, gerente e operador
  - Root pode alterar senha de qualquer perfil
}
