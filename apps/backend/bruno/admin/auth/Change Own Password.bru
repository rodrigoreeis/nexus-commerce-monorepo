meta {
  name: Change Own Password
  type: http
  seq: 2
}

patch {
  url: {{baseUrl}}/api/admin/auth/password
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{adminToken}}
}

body:json {
  {
    "current_password": "admin123",
    "new_password": "NewSecretPassword123!"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
}

docs {
  Altera a própria senha do usuário logado mediante confirmação da senha atual.
}
