meta {
  name: Create Product
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/admin/products
  body: multipart-form
  auth: none
}

body:multipart-form {
  name: Smartphone Nexus Pro
  price: 2999.90
  description: High-end smartphone with OLED display
  image: @file(../fixtures/sample.png)
}

assert {
  res.status: eq 201
  res.body.success: eq true
  res.body.data.id: isDefined
}

docs {
  Cadastra um novo produto no catálogo do Nexus Commerce via upload multipart/form-data.
}
